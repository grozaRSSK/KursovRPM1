<Window x:Class="KursovRPM.Auntificaqia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KursovRPM"
        mc:Ignorable="d"
        Title="Auntificaqia" Height="589" Width="857"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Icon="/ikon.png">
    <Window.Background>
        <ImageBrush ImageSource="/1792434287da89.png"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104*"/>
            <RowDefinition Height="39*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="43*"/>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="51*"/>
            <RowDefinition Height="115*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255*"/>
            <ColumnDefinition Width="347*"/>
            <ColumnDefinition Width="255*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Добро пожаловать!" Margin="42,104,38,0" FontSize="23" FontFamily="Arial Black" Grid.Column="1" RenderTransformOrigin="0.535,0.445" Grid.RowSpan="2"/>
        <Label Content="Зарегистрируйтесь для входа." Margin="57,39,58,0" FontSize="16" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" />

        <Label Content="Логин:" FontSize="16"  Margin="20,1,16,30" Grid.Column="1" Grid.RowSpan="2" Grid.Row="3"/>
        <TextBox x:Name="UsernameTextBox"  FontSize="16"  Margin="20,4,16,2" Grid.Column="1" Grid.Row="4"/>

        <Label Content="Пароль:"  FontSize="16"  Margin="20,5,16,6" Grid.Column="1" Grid.Row="5"/>
        <PasswordBox x:Name="PasswordBox" FontSize="16"  Margin="20,42,16,27" Grid.Column="1" Grid.RowSpan="2" Grid.Row="5"/>

        <Button x:Name="VxodButton" Content="Войти" Click="ProfileButton_Click" Margin="29,59,30,8" BorderBrush="{x:Null}" Foreground="{x:Null}" Opacity="0" Grid.Column="1" Grid.Row="7" Grid.RowSpan="2"/>
        <Button x:Name="RegestButton" Content="Войти" Click="RegisterButton_Click" Margin="32,16,28,0" BorderBrush="{x:Null}" Foreground="{x:Null}" Opacity="0" Grid.Column="1" Grid.Row="7"/>
    </Grid>
</Window>
